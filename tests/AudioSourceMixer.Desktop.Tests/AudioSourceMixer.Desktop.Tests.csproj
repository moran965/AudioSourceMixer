<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AudioSourceMixer.Desktop\AudioSourceMixer.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\src\AudioSourceMixer.Desktop\MainWindow.xaml" Link="MainWindow.source.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Views\MixerView.xaml" Link="SourceXaml\MixerView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Views\SettingsView.xaml" Link="SourceXaml\SettingsView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Views\BrowserSetupView.xaml" Link="SourceXaml\BrowserSetupView.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Controls\AudioSourceCard.xaml" Link="SourceXaml\AudioSourceCard.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Controls\EqualizerPanel.xaml" Link="SourceXaml\EqualizerPanel.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\App.xaml" Link="SourceXaml\App.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Themes\Colors.xaml" Link="SourceXaml\Themes\Colors.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Themes\Typography.xaml" Link="SourceXaml\Themes\Typography.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\Themes\Controls.xaml" Link="SourceXaml\Themes\Controls.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\AudioSourceMixer.Desktop\**\*.cs"
          Exclude="..\..\src\AudioSourceMixer.Desktop\bin\**;..\..\src\AudioSourceMixer.Desktop\obj\**"
          Link="SourceCode\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\generated\AudioSourceMixer-page.png" Link="IconAssets\AudioSourceMixer-page.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\generated\AudioSourceMixer.ico" Link="IconAssets\AudioSourceMixer.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
