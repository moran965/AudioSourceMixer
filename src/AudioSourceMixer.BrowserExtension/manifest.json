{
  "manifest_version": 3,
  "name": "Audio Source Mixer 标签页增强",
  "version": "0.2.0",
  "description": "在用户点击后，将当前标签页音频交给 Audio Source Mixer 独立控制。",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "启用或停止当前标签页的独立音频控制"
  },
  "options_ui": {
    "page": "output-authorization/authorize.html",
    "open_in_tab": true
  }
}
