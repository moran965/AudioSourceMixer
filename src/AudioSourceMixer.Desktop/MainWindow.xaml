<Window x:Class="AudioSourceMixer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioSourceMixer.Desktop.Views"
        xmlns:l="clr-namespace:AudioSourceMixer.Desktop.Localization"
        Title="{l:Loc Key=Common.ProductName}" Icon="Assets/AudioSourceMixer.ico"
        Width="1240" Height="820" MinWidth="880" MinHeight="600"
        Style="{DynamicResource ApplicationWindowTypographyStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                <Image Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"
                       AutomationProperties.Name="{l:Loc Key=Main.ProductIconAutomation}">
                    <Image.Source>
                        <BitmapImage UriSource="Assets/AudioSourceMixer-page.png" DecodePixelWidth="128" CacheOption="OnLoad"/>
                    </Image.Source>
                </Image>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{l:Loc Key=Common.ProductName}" Style="{DynamicResource TitleTextStyle}"/>
                <TextBlock Text="{l:Loc Key=Main.Tagline}" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="{l:Loc Key=Main.RestoreAll}" Command="{Binding RestoreAllCommand, Mode=OneWay}"
                    VerticalAlignment="Center" ToolTip="{l:Loc Key=Main.RestoreAllTip}"
                    AutomationProperties.Name="{l:Loc Key=Main.RestoreAll}"/>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue">
                <RadioButton Content="{l:Loc Key=Main.NavMixer}" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsMixerPageSelected, Mode=OneWay}" Command="{Binding NavigateMixerCommand, Mode=OneWay}"
                             AutomationProperties.Name="{l:Loc Key=Main.OpenMixerAutomation}"/>
                <RadioButton Content="{l:Loc Key=Main.NavBrowser}" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsBrowserSetupPageSelected, Mode=OneWay}" Command="{Binding NavigateBrowserSetupCommand, Mode=OneWay}"
                             AutomationProperties.Name="{l:Loc Key=Main.OpenBrowserAutomation}"/>
                <RadioButton Content="{l:Loc Key=Main.NavSettings}" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsSettingsPageSelected, Mode=OneWay}" Command="{Binding NavigateSettingsCommand, Mode=OneWay}"
                             AutomationProperties.Name="{l:Loc Key=Main.OpenSettingsAutomation}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <views:MixerView x:Name="MixerPageView" Visibility="{Binding MixerPageVisibility, Mode=OneWay}"/>
            <views:BrowserSetupView x:Name="BrowserSetupPageView" Visibility="{Binding BrowserSetupPageVisibility, Mode=OneWay}"/>
            <views:SettingsView x:Name="SettingsPageView" Visibility="{Binding SettingsPageVisibility, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>
