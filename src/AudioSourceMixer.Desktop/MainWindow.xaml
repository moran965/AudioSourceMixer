<Window x:Class="AudioSourceMixer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioSourceMixer.Desktop.Views"
        Title="Audio Source Mixer" Icon="Assets/AudioSourceMixer.ico"
        Width="1240" Height="820" MinWidth="880" MinHeight="600"
        Style="{DynamicResource ApplicationWindowTypographyStyle}"
        Background="{DynamicResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                <Image Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"
                       AutomationProperties.Name="Audio Source Mixer 产品图标">
                    <Image.Source>
                        <BitmapImage UriSource="Assets/AudioSourceMixer-page.png" DecodePixelWidth="128" CacheOption="OnLoad"/>
                    </Image.Source>
                </Image>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Audio Source Mixer" Style="{DynamicResource TitleTextStyle}"/>
                <TextBlock Text="分别控制应用和浏览器标签页的声音" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" Content="恢复全部来源" Command="{Binding RestoreAllCommand, Mode=OneWay}"
                    VerticalAlignment="Center" ToolTip="恢复音量、静音、平衡、输出设备和音效"
                    AutomationProperties.Name="恢复全部来源"/>
        </Grid>

        <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Padding="4" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Continue">
                <RadioButton Content="混音器" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsMixerPageSelected, Mode=OneWay}" Command="{Binding NavigateMixerCommand, Mode=OneWay}"
                             AutomationProperties.Name="打开混音器"/>
                <RadioButton Content="浏览器增强" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsBrowserSetupPageSelected, Mode=OneWay}" Command="{Binding NavigateBrowserSetupCommand, Mode=OneWay}"
                             AutomationProperties.Name="打开浏览器增强设置"/>
                <RadioButton Content="设置" GroupName="MainNavigation" Style="{DynamicResource NavigationButtonStyle}"
                             IsChecked="{Binding IsSettingsPageSelected, Mode=OneWay}" Command="{Binding NavigateSettingsCommand, Mode=OneWay}"
                             AutomationProperties.Name="打开设置"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <views:MixerView x:Name="MixerPageView" Visibility="{Binding MixerPageVisibility, Mode=OneWay}"/>
            <views:BrowserSetupView x:Name="BrowserSetupPageView" Visibility="{Binding BrowserSetupPageVisibility, Mode=OneWay}"/>
            <views:SettingsView x:Name="SettingsPageView" Visibility="{Binding SettingsPageVisibility, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>
