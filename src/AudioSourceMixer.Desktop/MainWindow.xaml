<Window x:Class="AudioSourceMixer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioSourceMixer.Desktop.Controls"
        Title="Audio Source Mixer" Icon="Assets/AudioSourceMixer.ico"
        Width="1180" Height="760" MinWidth="880" MinHeight="600"
        Background="#F1F5F9" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Audio Source Mixer" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                <TextBlock Text="分别控制应用和浏览器标签页的声音。" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="恢复全部来源" Command="{Binding RestoreAllCommand, Mode=OneWay}"
                    Background="#E2E8F0" VerticalAlignment="Center" ToolTip="恢复音量、静音、平衡、输出设备和音效"/>
        </DockPanel>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem x:Name="MixerTab" Header="混音器">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="13" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="当前默认输出" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Visibility="{Binding BrowserStatusVisibility, Mode=OneWay}" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="浏览器增强" FontSize="11" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding BrowserStatus, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="SourcesItemsControl" Grid.Row="1" ItemsSource="{Binding Sources, Mode=OneWay}"
                             Background="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SourceDescription, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1" Value="{Binding PeakPercent, Mode=OneWay}" Maximum="100" Height="8"
                                                     VerticalAlignment="Center" ToolTip="实时音量"/>
                                    </Grid>

                                    <Border Grid.Row="1" Background="#FFF7ED" CornerRadius="5" Padding="8,5" Margin="0,8,0,0"
                                            Visibility="{Binding UserStatusVisibility, Mode=OneWay}">
                                        <TextBlock Text="{Binding UserStatusMessage, Mode=OneWay}" Foreground="#9A3412" TextWrapping="Wrap"/>
                                    </Border>

                                    <Grid Grid.Row="2" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.25*" MinWidth="150"/>
                                            <ColumnDefinition Width="1.15*" MinWidth="145"/>
                                            <ColumnDefinition Width="1.2*" MinWidth="155"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                            <DockPanel><TextBlock Text="音量" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VolumePercent, Mode=OneWay, StringFormat={}{0:F0}%}"/></DockPanel>
                                            <Slider Minimum="0" Maximum="{Binding VolumeMaximum, Mode=OneWay}" TickFrequency="10"
                                                    Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    AutomationProperties.Name="音量"/>
                                            <TextBlock Text="{Binding GainWarning, Mode=OneWay}" Visibility="{Binding GainWarningVisibility, Mode=OneWay}"
                                                       FontSize="10" Foreground="#B45309" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <DockPanel><TextBlock Text="声道平衡" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding BalanceText, Mode=OneWay}" FontSize="10" Foreground="{StaticResource MutedTextBrush}"/></DockPanel>
                                            <controls:CenterDetentSlider Minimum="-100" Maximum="100" TickFrequency="1"
                                                Value="{Binding BalancePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsEnabled="{Binding SupportsBalance, Mode=OneWay}" AutomationProperties.Name="声道平衡"/>
                                            <Grid><TextBlock Text="左" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="居中" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="右" FontSize="9" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/></Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                            <TextBlock Text="输出设备" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <ComboBox ItemsSource="{Binding OutputDevices, Mode=OneWay}" SelectedValuePath="Id"
                                                SelectedValue="{Binding SelectedOutputDeviceId, Mode=OneWay}" IsEnabled="{Binding SupportsOutputRouting, Mode=OneWay}"
                                                PreviewMouseLeftButtonUp="OutputDeviceItemClicked" PreviewKeyDown="OutputDeviceKeyDown"
                                                DisplayMemberPath="Name" ToolTip="{Binding OutputStatus, Mode=OneWay}"
                                                AutomationProperties.Name="输出设备"/>
                                            <Button Content="打开授权页" Command="{Binding ReauthorizeOutputCommand, Mode=OneWay}"
                                                Visibility="{Binding ReauthorizeOutputVisibility, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="{Binding MuteLabel, Mode=OneWay}" Command="{Binding ToggleMuteCommand, Mode=OneWay}"/>
                                            <Button Content="恢复" Command="{Binding RestoreCommand, Mode=OneWay}" ToolTip="只恢复此来源"/>
                                            <Button Content="停止增强" Command="{Binding StopCommand, Mode=OneWay}" Visibility="{Binding StopVisibility, Mode=OneWay}"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="SettingsTab" Header="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                    <StackPanel>
                        <GroupBox Header="启动与窗口" Margin="0,0,0,10"><StackPanel Margin="12">
                            <CheckBox Content="登录 Windows 后启动" IsChecked="{Binding StartupEnabled, Mode=TwoWay}" IsEnabled="{Binding StartupAvailable, Mode=OneWay}"/>
                            <CheckBox Content="启动后留在系统托盘" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}" IsEnabled="{Binding StartupEnabled, Mode=OneWay}" Margin="0,7,0,0"/>
                            <CheckBox Content="关闭窗口时留在托盘" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,7,0,0"/>
                            <CheckBox Content="显示操作提示" IsChecked="{Binding ShowOperationTips, Mode=TwoWay}" Margin="0,7,0,0"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="会话与记忆" Margin="0,0,0,10"><StackPanel Margin="12">
                            <CheckBox Content="显示当前无声会话" IsChecked="{Binding ShowInactiveSessions, Mode=TwoWay}"/>
                            <CheckBox Content="记住应用设置" IsChecked="{Binding RememberProfiles, Mode=TwoWay}" Margin="0,7,0,0"/>
                            <CheckBox Content="自动应用已保存设置" IsChecked="{Binding AutoApplyProfiles, Mode=TwoWay}" IsEnabled="{Binding AutoApplyProfilesEnabled, Mode=OneWay}" Margin="0,7,0,0"/>
                            <Button Content="清除已保存配置" Command="{Binding ClearProfilesCommand, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,9,0,0"/>
                        </StackPanel></GroupBox>
                        <GroupBox Header="浏览器增强" Margin="0,0,0,10"><StackPanel Margin="12">
                            <TextBlock Text="{Binding EdgeConnectionStatus, Mode=OneWay}"/><TextBlock Text="{Binding ChromeConnectionStatus, Mode=OneWay}" Margin="0,3,0,0"/>
                            <TextBlock Text="首次选择输出设备时，需要在浏览器授权页试听并确认。" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <WrapPanel Margin="0,9,0,0"><Button Content="管理 Edge 输出" Command="{Binding ManageEdgeOutputsCommand, Mode=OneWay}"/>
                                <Button Content="清除 Edge 映射" Command="{Binding ClearEdgeMappingsCommand, Mode=OneWay}" Background="#E2E8F0"/>
                                <Button Content="管理 Chrome 输出" Command="{Binding ManageChromeOutputsCommand, Mode=OneWay}"/>
                                <Button Content="清除 Chrome 映射" Command="{Binding ClearChromeMappingsCommand, Mode=OneWay}" Background="#E2E8F0"/></WrapPanel>
                        </StackPanel></GroupBox>
                        <GroupBox Header="维护与关于"><StackPanel Margin="12">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VersionText, Mode=OneWay}" FontWeight="SemiBold"/>
                                <TextBlock Text=" · "/><TextBlock Text="{Binding DeploymentText, Mode=OneWay}"/></StackPanel>
                            <WrapPanel Margin="0,9,0,0"><Button Content="恢复全部来源与设置" Command="{Binding ResetAllCommand, Mode=OneWay}"/>
                                <Button Content="刷新来源" Command="{Binding RefreshCommand, Mode=OneWay}"/>
                                <Button Content="打开日志目录" Command="{Binding OpenLogsCommand, Mode=OneWay}"/>
                                <Button Content="打开程序目录" Command="{Binding OpenInstallDirectoryCommand, Mode=OneWay}"/></WrapPanel>
                            <Expander Header="帮助与技术详情" Margin="4,10,0,0">
                                <TextBlock Text="普通应用使用 Windows 原生音量、静音、平衡和输出策略；浏览器增强只在你点击扩展按钮后处理当前标签页。退出程序会恢复本次运行修改。"
                                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </Expander>
                        </StackPanel></GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
