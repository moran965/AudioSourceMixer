<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ApplicationFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, Global User Interface</FontFamily>
    <Style x:Key="ApplicationControlTypographyStyle" TargetType="Control">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="ApplicationWindowTypographyStyle" TargetType="Window"
           BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="Window" BasedOn="{StaticResource ApplicationWindowTypographyStyle}"/>
    <Style TargetType="UserControl" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="Label" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="RadioButton" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="Expander" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="ToolTip" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="MenuItem" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource ApplicationControlTypographyStyle}"/>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFont}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="BodySecondaryTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ApplicationFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySecondaryTextStyle}">
        <Setter Property="FontSize" Value="11"/>
    </Style>
</ResourceDictionary>
