<UserControl x:Class="AudioSourceMixer.Desktop.Views.BrowserSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AudioSourceMixer.Desktop.Localization"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer x:Name="BrowserSetupScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,10,0">
            <Border Style="{DynamicResource CardBorderStyle}" Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,0,10"
                    Visibility="{Binding IsFirstRunBrowserWelcome, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Key=Browser.WelcomeTitle}" Style="{DynamicResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{l:Loc Key=Browser.WelcomeDescription}"
                                   TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{l:Loc Key=Browser.SetupNow}" Command="{Binding BeginBrowserSetupCommand, Mode=OneWay}"
                                Style="{DynamicResource PrimaryButtonStyle}" AutomationProperties.Name="{l:Loc Key=Browser.SetupNowAutomation}" Margin="0,0,8,0"/>
                        <Button Content="{l:Loc Key=Browser.SetupLater}" Command="{Binding DeferBrowserSetupCommand, Mode=OneWay}"
                                AutomationProperties.Name="{l:Loc Key=Browser.SetupLaterAutomation}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Browser.ConnectionSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{l:Loc Key=Browser.ConnectionDescription}" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="9" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Microsoft Edge" FontWeight="Bold"/>
                                <TextBlock Text="{Binding EdgeGuideStatus, Mode=OneWay}" Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Button Content="{l:Loc Key=Browser.OpenEdge}" Command="{Binding OpenEdgeExtensionsCommand, Mode=OneWay}"
                                        HorizontalAlignment="Left" AutomationProperties.Name="{l:Loc Key=Browser.OpenEdgeAutomation}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="9" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Google Chrome" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ChromeGuideStatus, Mode=OneWay}" Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Button Content="{l:Loc Key=Browser.OpenChrome}" Command="{Binding OpenChromeExtensionsCommand, Mode=OneWay}"
                                        HorizontalAlignment="Left" AutomationProperties.Name="{l:Loc Key=Browser.OpenChromeAutomation}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding NativeHostRegistrationStatus, Mode=OneWay}" Style="{DynamicResource BodySecondaryTextStyle}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Browser.LocalInstallSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{l:Loc Key=Browser.LocalInstallDescription}"
                               Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="1" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold"/><TextBlock Grid.Row="0" Grid.Column="1" Text="{l:Loc Key=Browser.Step1}" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="2" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{l:Loc Key=Browser.Step2}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Text="3" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{l:Loc Key=Browser.Step3}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Text="4" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{l:Loc Key=Browser.Step4}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="4" Text="5" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{l:Loc Key=Browser.Step5}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="5" Text="6" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{l:Loc Key=Browser.Step6}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </Grid>
                    <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="7" Padding="10" Margin="0,12,0,0">
                        <TextBlock Text="{Binding ExtensionDirectoryText, Mode=OneWay}" ToolTip="{Binding ExtensionDirectoryText, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.Name="{l:Loc Key=Browser.ExtensionDirectoryAutomation}"/>
                    </Border>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{l:Loc Key=Browser.OpenFolder}" Command="{Binding OpenExtensionDirectoryCommand, Mode=OneWay}"
                                AutomationProperties.Name="{l:Loc Key=Browser.OpenFolder}" Margin="0,0,8,8"/>
                        <Button Content="{l:Loc Key=Browser.CopyFolder}" Command="{Binding CopyExtensionDirectoryCommand, Mode=OneWay}"
                                AutomationProperties.Name="{l:Loc Key=Browser.CopyFolder}" Margin="0,0,8,8"/>
                        <Button Content="{l:Loc Key=Browser.Recheck}" Command="{Binding RecheckBrowserSetupCommand, Mode=OneWay}"
                                AutomationProperties.Name="{l:Loc Key=Browser.RecheckAutomation}" Margin="0,0,8,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Key=Browser.PrivacySection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{l:Loc Key=Browser.PrivacyDescription}"
                                   Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,20,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:Loc Key=Browser.NeverPrompt}" Command="{Binding DisableBrowserGuidePromptCommand, Mode=OneWay}"
                            Style="{DynamicResource QuietButtonStyle}" AutomationProperties.Name="{l:Loc Key=Browser.NeverPromptAutomation}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
