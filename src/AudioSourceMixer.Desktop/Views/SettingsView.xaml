<UserControl x:Class="AudioSourceMixer.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AudioSourceMixer.Desktop.Localization"
             Focusable="False">
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,10,0">
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{l:Loc Key=Settings.LanguageSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{l:Loc Key=Settings.LanguageDescription}" Style="{DynamicResource BodySecondaryTextStyle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{l:Loc Key=Settings.LanguageLabel}" Style="{DynamicResource CaptionTextStyle}" Margin="0,0,0,5"/>
                        <ComboBox x:Name="LanguageComboBox" Width="180" ItemsSource="{Binding LanguageOptions, Mode=OneWay}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="{l:Loc Key=Settings.LanguageAutomation}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Settings.StartupSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{l:Loc Key=Settings.StartupDescription}" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,10"/>
                    <CheckBox Content="{l:Loc Key=Settings.StartWithWindows}" IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding StartupAvailable, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.StartWithWindows}"/>
                    <CheckBox Content="{l:Loc Key=Settings.StartInTray}" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                              IsEnabled="{Binding StartupEnabled, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.StartInTray}"/>
                    <CheckBox Content="{l:Loc Key=Settings.CloseToTray}" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                              AutomationProperties.Name="{l:Loc Key=Settings.CloseToTray}"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Settings.SessionSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="{l:Loc Key=Settings.SessionDescription}" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,10"/>
                    <CheckBox Content="{l:Loc Key=Settings.ShowInactive}" IsChecked="{Binding ShowInactiveSessions, Mode=TwoWay}"
                              AutomationProperties.Name="{l:Loc Key=Settings.ShowInactive}"/>
                    <CheckBox Content="{l:Loc Key=Settings.HideBrowserAggregate}"
                              IsChecked="{Binding HideBrowserAggregateSessions, Mode=TwoWay}"
                              ToolTip="{l:Loc Key=Settings.HideBrowserAggregateTip}"
                              AutomationProperties.Name="{l:Loc Key=Settings.HideBrowserAggregate}"/>
                    <CheckBox Content="{l:Loc Key=Settings.RememberProfiles}" IsChecked="{Binding RememberProfiles, Mode=TwoWay}"
                              AutomationProperties.Name="{l:Loc Key=Settings.RememberProfiles}"/>
                    <CheckBox Content="{l:Loc Key=Settings.AutoApply}" IsChecked="{Binding AutoApplyProfiles, Mode=TwoWay}"
                              IsEnabled="{Binding AutoApplyProfilesEnabled, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.AutoApply}"/>
                    <Button Content="{l:Loc Key=Settings.ClearProfiles}" Command="{Binding ClearProfilesCommand, Mode=OneWay}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="{l:Loc Key=Settings.ClearProfiles}"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{l:Loc Key=Settings.BrowserSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                        <TextBlock Text="{l:Loc Key=Settings.BrowserDescription}" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{l:Loc Key=Settings.OpenBrowserGuide}" Command="{Binding NavigateBrowserSetupCommand, Mode=OneWay}"
                            Style="{DynamicResource PrimaryButtonStyle}" AutomationProperties.Name="{l:Loc Key=Settings.OpenBrowserGuideAutomation}"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Settings.AppearanceSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <CheckBox Content="{l:Loc Key=Settings.ShowTips}" IsChecked="{Binding ShowOperationTips, Mode=TwoWay}"
                              Margin="0,8,0,0" AutomationProperties.Name="{l:Loc Key=Settings.ShowTips}"/>
                    <TextBlock Text="{l:Loc Key=Settings.ScrollDescription}"
                               Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="{l:Loc Key=Settings.DiagnosticsSection}" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeploymentText, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="{l:Loc Key=Settings.RefreshSources}" Command="{Binding RefreshCommand, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.RefreshSources}" Margin="0,0,8,8"/>
                        <Button Content="{l:Loc Key=Settings.OpenLogs}" Command="{Binding OpenLogsCommand, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.OpenLogs}" Margin="0,0,8,8"/>
                        <Button Content="{l:Loc Key=Settings.OpenInstallDirectory}" Command="{Binding OpenInstallDirectoryCommand, Mode=OneWay}" AutomationProperties.Name="{l:Loc Key=Settings.OpenInstallDirectory}" Margin="0,0,8,8"/>
                        <Button Content="{l:Loc Key=Settings.ResetAll}" Command="{Binding ResetAllCommand, Mode=OneWay}"
                                Style="{DynamicResource DangerButtonStyle}" AutomationProperties.Name="{l:Loc Key=Settings.ResetAll}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <Expander Header="{l:Loc Key=Settings.TechnicalDetails}" Margin="0,4,0,0" AutomationProperties.Name="{l:Loc Key=Settings.TechnicalDetails}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding NativeHostRegistrationStatus, Mode=OneWay}" Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{l:Loc Key=Settings.TechnicalDescription}"
                                       Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
