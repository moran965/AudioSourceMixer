<UserControl x:Class="AudioSourceMixer.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly">
        <StackPanel Margin="0,0,10,0">
            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="启动与托盘" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="决定程序何时出现，以及关闭窗口后的行为。" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,10"/>
                    <CheckBox Content="登录 Windows 后启动" IsChecked="{Binding StartupEnabled, Mode=TwoWay}"
                              IsEnabled="{Binding StartupAvailable, Mode=OneWay}" AutomationProperties.Name="登录 Windows 后启动"/>
                    <CheckBox Content="启动后留在系统托盘" IsChecked="{Binding StartMinimizedToTray, Mode=TwoWay}"
                              IsEnabled="{Binding StartupEnabled, Mode=OneWay}" AutomationProperties.Name="启动后留在系统托盘"/>
                    <CheckBox Content="关闭窗口时留在托盘" IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                              AutomationProperties.Name="关闭窗口时留在托盘"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="会话显示与设置记忆" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Text="控制来源列表和下次启动时的恢复方式。" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,10"/>
                    <CheckBox Content="显示当前无声会话" IsChecked="{Binding ShowInactiveSessions, Mode=TwoWay}"
                              AutomationProperties.Name="显示当前无声会话"/>
                    <CheckBox Content="记住应用设置" IsChecked="{Binding RememberProfiles, Mode=TwoWay}"
                              AutomationProperties.Name="记住应用设置"/>
                    <CheckBox Content="自动应用已保存设置" IsChecked="{Binding AutoApplyProfiles, Mode=TwoWay}"
                              IsEnabled="{Binding AutoApplyProfilesEnabled, Mode=OneWay}" AutomationProperties.Name="自动应用已保存设置"/>
                    <Button Content="清除已保存配置" Command="{Binding ClearProfilesCommand, Mode=OneWay}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.Name="清除已保存配置"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="浏览器增强" Style="{DynamicResource SectionTitleTextStyle}"/>
                        <TextBlock Text="按标签页控制最高 200% 音量、EQ 和输出设备。" Style="{DynamicResource BodySecondaryTextStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="打开设置向导" Command="{Binding NavigateBrowserSetupCommand, Mode=OneWay}"
                            Style="{DynamicResource PrimaryButtonStyle}" AutomationProperties.Name="打开浏览器增强设置向导"/>
                </Grid>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="外观与交互" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <CheckBox Content="显示操作提示" IsChecked="{Binding ShowOperationTips, Mode=TwoWay}"
                              Margin="0,8,0,0" AutomationProperties.Name="显示操作提示"/>
                    <TextBlock Text="来源列表使用连续像素滚动；未聚焦的滑块不会被滚轮意外修改。"
                               Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="诊断与关于" Style="{DynamicResource SectionTitleTextStyle}"/>
                    <TextBlock Margin="0,5,0,0">
                        <Run Text="{Binding VersionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding DeploymentText, Mode=OneWay}"/>
                    </TextBlock>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="刷新来源" Command="{Binding RefreshCommand, Mode=OneWay}" AutomationProperties.Name="刷新来源" Margin="0,0,8,8"/>
                        <Button Content="打开日志目录" Command="{Binding OpenLogsCommand, Mode=OneWay}" AutomationProperties.Name="打开日志目录" Margin="0,0,8,8"/>
                        <Button Content="打开程序目录" Command="{Binding OpenInstallDirectoryCommand, Mode=OneWay}" AutomationProperties.Name="打开程序目录" Margin="0,0,8,8"/>
                        <Button Content="恢复全部来源与设置" Command="{Binding ResetAllCommand, Mode=OneWay}"
                                Style="{DynamicResource DangerButtonStyle}" AutomationProperties.Name="恢复全部来源与设置" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <Expander Header="技术详情" Margin="0,4,0,0" AutomationProperties.Name="技术详情">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding NativeHostRegistrationStatus, Mode=OneWay}" Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="普通应用使用 Windows 原生音量、静音、平衡和输出策略；浏览器增强只在你点击扩展按钮后处理当前标签页。退出程序会恢复本次运行修改。"
                                       Style="{DynamicResource BodySecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
