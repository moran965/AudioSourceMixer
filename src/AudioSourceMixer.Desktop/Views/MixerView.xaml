<UserControl x:Class="AudioSourceMixer.Desktop.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioSourceMixer.Desktop.Controls"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前默认输出" Style="{DynamicResource CaptionTextStyle}"/>
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button x:Name="SortMenuButton" Style="{DynamicResource QuietButtonStyle}" MinWidth="0" MinHeight="30" Padding="8,4"
                            Content="调整顺序" ToolTip="拖动卡片右上角把手可调整顺序"
                            AutomationProperties.Name="调整会话顺序" Click="OpenHeaderMenu"/>
                    <Popup x:Name="OrderMenuPopup" PlacementTarget="{x:Reference SortMenuButton}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Style="{DynamicResource CardBorderStyle}" Padding="8" Width="250" Margin="0,6,0,0">
                            <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                                <TextBlock Text="拖动卡片右上角把手可调整顺序" Style="{DynamicResource CaptionTextStyle}"
                                           TextWrapping="Wrap" Margin="7,4,7,7"/>
                                <Button Content="恢复默认顺序" Command="{Binding ResetSourceOrderCommand, Mode=OneWay}"
                                        Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="恢复默认会话顺序"/>
                                <Button Content="恢复浏览器自动隐藏规则" Command="{Binding RestoreBrowserAutoHideCommand, Mode=OneWay}"
                                        Visibility="{Binding BrowserAutoHideRestoreVisibility, Mode=OneWay}"
                                        Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="恢复浏览器自动隐藏规则"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button x:Name="HiddenSourcesButton" Style="{DynamicResource QuietButtonStyle}" MinWidth="0" MinHeight="30" Padding="8,4"
                            Content="{Binding HiddenSourcesLabel, Mode=OneWay}" Visibility="{Binding HiddenSourcesVisibility, Mode=OneWay}"
                            ToolTip="查看被隐藏的会话" AutomationProperties.Name="查看隐藏会话" Click="ToggleHiddenSourcesPopup"/>
                    <StackPanel Visibility="{Binding BrowserStatusVisibility, Mode=OneWay}" Margin="16,0,0,0">
                        <TextBlock Text="浏览器增强" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding BrowserStatus, Mode=OneWay}" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Popup x:Name="HiddenSourcesPopup" PlacementTarget="{x:Reference HiddenSourcesButton}" Placement="Bottom"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{DynamicResource CardBorderStyle}" Padding="12" Width="380" MaxHeight="360" Margin="0,6,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="隐藏的会话" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="全部恢复显示" Command="{Binding RestoreAllHiddenCommand, Mode=OneWay}"
                                        Style="{DynamicResource QuietButtonStyle}" MinHeight="28" MinWidth="0" Padding="7,3"
                                        ToolTip="显示所有手动隐藏和浏览器自动隐藏的会话"/>
                            </Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding HiddenSources, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Style="{DynamicResource CaptionTextStyle}" TextWrapping="Wrap">
                                                        <Run Text="{Binding SourceType, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Reason, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="{Binding RestoreLabel, Mode=OneWay}" Command="{Binding RestoreCommand, Mode=OneWay}"
                                                        Margin="10,0,0,0"
                                                        Style="{DynamicResource QuietButtonStyle}" MinHeight="28" MinWidth="0" Padding="7,3"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="SourceScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True" IsDeferredScrollingEnabled="False" PanningMode="VerticalOnly"
                          Focusable="False">
                <ItemsControl x:Name="SourcesItemsControl" ItemsSource="{Binding Sources, Mode=OneWay}"
                              Background="{x:Null}" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AllowDrop="True" DragOver="SourcesDragOver" DragLeave="SourcesDragLeave" Drop="SourcesDrop"
                              KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel IsItemsHost="True"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><controls:AudioSourceCard/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border x:Name="InsertionLine" Height="2" Background="{DynamicResource PrimaryBrush}"
                    CornerRadius="1" VerticalAlignment="Top" Margin="8,0,18,0" Visibility="Collapsed"
                    IsHitTestVisible="False" Panel.ZIndex="10">
                <Border.RenderTransform><TranslateTransform x:Name="InsertionLineTransform"/></Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</UserControl>
