<UserControl x:Class="AudioSourceMixer.Desktop.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioSourceMixer.Desktop.Controls"
             Focusable="False">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{DynamicResource CardBorderStyle}" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="当前默认输出" Style="{DynamicResource CaptionTextStyle}"/>
                    <TextBlock Text="{Binding DeviceName, Mode=OneWay}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName, Mode=OneWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Visibility="{Binding BrowserStatusVisibility, Mode=OneWay}"
                            VerticalAlignment="Center" Margin="24,0,0,0">
                    <TextBlock Text="浏览器增强" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding BrowserStatus, Mode=OneWay}" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryDarkBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <ListBox x:Name="SourcesItemsControl" Grid.Row="1" ItemsSource="{Binding Sources, Mode=OneWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.IsDeferredScrollingEnabled="False"
                 ScrollViewer.PanningMode="VerticalOnly"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 KeyboardNavigation.TabNavigation="Continue">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate><controls:AudioSourceCard/></DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
