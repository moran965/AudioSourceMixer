<UserControl x:Class="AudioSourceMixer.Desktop.Controls.AudioSourceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AudioSourceMixer.Desktop.Controls"
             xmlns:l="clr-namespace:AudioSourceMixer.Desktop.Localization"
             Focusable="False" AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"
             Unloaded="AudioSourceCardUnloaded" LayoutUpdated="AudioSourceCardLayoutUpdated"
             IsVisibleChanged="AudioSourceCardIsVisibleChanged">
    <Border x:Name="CardRoot" Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,10" Padding="16,14"
            Opacity="{Binding DragPlaceholderOpacity, Mode=OneWay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{DynamicResource PrimarySoftBrush}" CornerRadius="10" Padding="9,5" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding SourceTypeLabel, Mode=OneWay}" Foreground="{DynamicResource PrimaryDarkBrush}"
                               FontWeight="Bold" FontSize="10"/>
                </Border>
                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}"
                        Margin="0,0,10,0" VerticalAlignment="Center">
                    <Image Source="{Binding IconSource, Mode=OneWay}" Width="24" Height="24"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="{Binding DisplayName, Mode=OneWay}"/>
                </Border>
                <StackPanel Grid.Column="2" MinWidth="0">
                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" ToolTip="{Binding DisplayName, Mode=OneWay}"
                               FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding SourceDescription, Mode=OneWay}" ToolTip="{Binding SourceDescription, Mode=OneWay}"
                               Style="{DynamicResource CaptionTextStyle}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{l:Loc Key=Card.LiveLevel}" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                    <controls:DeterminateProgressBar Value="{Binding PeakPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,5,0,0"
                                                     AutomationProperties.Name="{l:Loc Key=Card.LiveVolumeAutomation}"/>
                </StackPanel>
                <Button x:Name="DragHandle" Grid.Column="4" Style="{DynamicResource IconButtonStyle}" Margin="8,0,0,0"
                        ToolTip="{l:Loc Key=Card.DragTip}" Cursor="SizeAll"
                        AutomationProperties.Name="{l:Loc Key=Card.DragAutomation}"
                        PreviewMouseLeftButtonDown="DragHandleMouseDown" PreviewMouseMove="DragHandleMouseMove"
                        PreviewMouseLeftButtonUp="DragHandleMouseUp" LostMouseCapture="DragHandleLostMouseCapture"
                        QueryContinueDrag="DragHandleQueryContinueDrag">
                    <Canvas Width="12" Height="16" IsHitTestVisible="False">
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="1" Canvas.Top="1"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="8" Canvas.Top="1"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="1" Canvas.Top="6.5"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="8" Canvas.Top="6.5"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="1" Canvas.Top="12"/>
                        <Ellipse Width="3" Height="3" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Canvas.Left="8" Canvas.Top="12"/>
                    </Canvas>
                </Button>
                <Button x:Name="SourceMenuButton" Grid.Column="5" Style="{DynamicResource IconButtonStyle}" Margin="2,0,0,0"
                        ToolTip="{l:Loc Key=Card.MenuTip}" AutomationProperties.Name="{l:Loc Key=Card.MenuAutomation}" Click="OpenSourceMenu">
                    <Path Data="M 3,8 L 3.01,8 M 8,8 L 8.01,8 M 13,8 L 13.01,8"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}"
                          StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <Popup x:Name="SourceMenuPopup" Grid.Column="5" PlacementTarget="{x:Reference SourceMenuButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                       Closed="SourceMenuPopupClosed">
                    <Border Style="{DynamicResource CardBorderStyle}" Padding="7" Width="168" Margin="0,5,0,0">
                        <Border.Effect><DropShadowEffect Color="#330F172A" BlurRadius="14" ShadowDepth="3" Opacity="0.28"/></Border.Effect>
                        <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                            <Button Content="{l:Loc Key=Card.MoveTop}" Command="{Binding MoveToTopCommand, Mode=OneWay}"
                                    Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="{l:Loc Key=Card.MoveTopAutomation}"/>
                            <Button Content="{l:Loc Key=Card.MoveUp}" Command="{Binding MoveUpCommand, Mode=OneWay}"
                                    Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="{l:Loc Key=Card.MoveUpAutomation}"/>
                            <Button Content="{l:Loc Key=Card.MoveDown}" Command="{Binding MoveDownCommand, Mode=OneWay}"
                                    Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="{l:Loc Key=Card.MoveDownAutomation}"/>
                            <Button Content="{l:Loc Key=Card.MoveBottom}" Command="{Binding MoveToBottomCommand, Mode=OneWay}"
                                    Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="{l:Loc Key=Card.MoveBottomAutomation}"/>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="6,5"/>
                            <Button Content="{l:Loc Key=Card.Hide}" Command="{Binding HideCommand, Mode=OneWay}"
                                    Style="{DynamicResource FlyoutMenuButtonStyle}" AutomationProperties.Name="{l:Loc Key=Card.Hide}"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="10,7" Margin="0,10,0,0"
                    Visibility="{Binding UserStatusVisibility, Mode=OneWay}">
                <TextBlock Text="{Binding UserStatusMessage, Mode=OneWay}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="190"/>
                    <ColumnDefinition Width="1*" MinWidth="190"/>
                    <ColumnDefinition Width="1.2*" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Loc Key=Card.Volume}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding VolumePercent, Mode=OneWay, StringFormat={}{0:F0}%}"/>
                    </Grid>
                    <controls:WheelSafeSlider Minimum="0" Maximum="{Binding VolumeMaximum, Mode=OneWay}" TickFrequency="10"
                                               Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               AutomationProperties.Name="{l:Loc Key=Card.Volume}" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding GainWarning, Mode=OneWay}" Visibility="{Binding GainWarningVisibility, Mode=OneWay}"
                               Style="{DynamicResource CaptionTextStyle}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{l:Loc Key=Card.Balance}" FontWeight="Bold"/>
                        <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding BalanceText, Mode=OneWay}" Style="{DynamicResource CaptionTextStyle}"/>
                    </Grid>
                    <controls:CenterDetentSlider Minimum="-100" Maximum="100" TickFrequency="1"
                                                  Value="{Binding BalancePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding SupportsBalance, Mode=OneWay}"
                                                  AutomationProperties.Name="{l:Loc Key=Card.Balance}" Margin="0,7,0,0"/>
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="{l:Loc Key=Card.Left}" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{l:Loc Key=Card.Center}" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{l:Loc Key=Card.Right}" Style="{DynamicResource CaptionTextStyle}" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Loc Key=Card.OutputDevice}" FontWeight="Bold" Margin="0,0,0,7"/>
                    <ComboBox ItemsSource="{Binding OutputDevices, Mode=OneWay}" SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedOutputDeviceId, Mode=OneWay}"
                              IsEnabled="{Binding SupportsOutputRouting, Mode=OneWay}"
                              PreviewMouseLeftButtonUp="OutputDeviceItemClicked" PreviewKeyDown="OutputDeviceKeyDown"
                              DisplayMemberPath="Name" ToolTip="{Binding SelectedOutputDevice.Name, Mode=OneWay}"
                              AutomationProperties.Name="{l:Loc Key=Card.OutputDevice}"/>
                    <Button Content="{l:Loc Key=Card.OpenAuthorization}" Command="{Binding ReauthorizeOutputCommand, Mode=OneWay}"
                            Visibility="{Binding ReauthorizeOutputVisibility, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,7,0,0"
                            AutomationProperties.Name="{l:Loc Key=Card.OpenAuthorizationAutomation}"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="{Binding OutputStatus, Mode=OneWay}" ToolTip="{Binding OutputStatus, Mode=OneWay}"
                           Style="{DynamicResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{Binding MuteLabel, Mode=OneWay}" Command="{Binding ToggleMuteCommand, Mode=OneWay}"
                            AutomationProperties.Name="{l:Loc Key=Card.ToggleMuteAutomation}" Margin="6,0,0,0"/>
                    <Button Content="{l:Loc Key=Card.Restore}" Command="{Binding RestoreCommand, Mode=OneWay}" ToolTip="{l:Loc Key=Card.RestoreTip}"
                            AutomationProperties.Name="{l:Loc Key=Card.RestoreAutomation}" Margin="6,0,0,0"/>
                    <Button Content="{l:Loc Key=Card.StopEnhancement}" Command="{Binding StopCommand, Mode=OneWay}"
                            Visibility="{Binding StopVisibility, Mode=OneWay}" Style="{DynamicResource DangerButtonStyle}"
                            AutomationProperties.Name="{l:Loc Key=Card.StopEnhancementAutomation}" Margin="6,0,0,0"/>
                </WrapPanel>
            </Grid>

            <controls:EqualizerPanel Grid.Row="4" Margin="0,8,0,0"/>
        </Grid>
    </Border>
</UserControl>
